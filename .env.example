# Copy the values you need into your hosting provider's environment variables.
# Do NOT commit a filled-in .env file.

PORT=3000
PUBLIC_BASE_URL=https://siteinabox.divineguardian.org

# --- Database ---
# Neon Postgres connection string. Required on Vercel; optional locally.
# When set, leads/sales/follow-up state are stored in Neon. When empty,
# the local server falls back to lead-machine/data/*.json files.
# Get this from Neon Console -> your project -> Connect -> Connection string.
# Leave empty to use local JSON files.
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Protects /admin.html and /api/followup/run. Use a long random string.
LEAD_API_TOKEN=replace-with-a-long-random-string
# Signs unsubscribe links in follow-up messages.
FOLLOWUP_SECRET=replace-with-a-different-long-random-string

# --- Follow-up delivery (pick one or more) ---
# auto = email if available + Resend configured, else SMS, else webhook
# email | sms | webhook are also accepted
FOLLOWUP_CHANNEL=auto

# Email via Resend (free tier available)
RESEND_API_KEY=
EMAIL_FROM=Vinks Dev <hello@siteinabox.divineguardian.org>

# SMS via Termii (Nigeria)
TERMII_API_KEY=
TERMII_SENDER_ID=VinksDev

# SMS via Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# No-code option: POST each follow-up to n8n / Make / Zapier as JSON
FOLLOWUP_WEBHOOK_URL=

# --- Paystack ---
PAYSTACK_SECRET_KEY=

# Checkout charges the one-time setup fee from pricing.json.
# After a successful setup payment, a monthly subscription is created using this plan code.
# Create a ₦10,000/month plan in Paystack and paste its code here.
PAYSTACK_MONTHLY_PLAN_CODE=

# Optional: dashboard payment links. These take priority over API checkout.
PAYSTACK_LAUNCH_URL=
PAYSTACK_DFY_URL=

# Change setup/monthly prices in pricing.json — no code edits needed.
